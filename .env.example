# Web entrypoint
WEB_PORT=8080
API_PORT=9090
PUBLIC_BASE_URL=http://localhost:8080

# MySQL (replace every credential before exposing the stack)
MYSQL_DATABASE=oj_db
MYSQL_USER=zeorcode
MYSQL_PASSWORD=replace-with-a-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password

# Application secrets
ZEORCODE_JWT_SECRET=replace-with-a-long-random-jwt-secret
ZEORCODE_AES_KEY=replace-with-a-long-random-encryption-secret

# Judge worker
JUDGE_CONCURRENCY=4
# Set to true before scaling backend-judge to more than one replica.
JUDGE_MULTI_INSTANCE=false

# Optional OpenAI-compatible teaching assistant
ZEORCODE_AI_ENABLED=false
ZEORCODE_AI_BASE_URL=https://api.openai.com/v1
ZEORCODE_AI_MODEL=
ZEORCODE_AI_API_KEY=
