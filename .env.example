# Web entrypoint
WEB_PORT=8080
API_PORT=9090
PUBLIC_BASE_URL=http://localhost:8080

# MySQL (replace every credential before exposing the stack)
MYSQL_DATABASE=oj_db
MYSQL_USER=zeorcode
MYSQL_PASSWORD=replace-with-a-random-database-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password

# Application secrets
ZEORCODE_JWT_SECRET=replace-with-a-long-random-jwt-secret
ZEORCODE_AES_KEY=replace-with-a-long-random-encryption-secret

# Judge worker
JUDGE_CONCURRENCY=1
# Set to true before scaling backend-judge to more than one replica.
JUDGE_MULTI_INSTANCE=false
# direct: connect to the local go-judge HTTP API; agent: dispatch to remote judge-node services.
JUDGE_MODE=direct
# Comma-separated gRPC endpoints, for example: 10.0.0.21:60051,10.0.0.22:60051
JUDGE_AGENT_ADDRESSES=
# Required in agent mode. Generate two different random values; never reuse these examples as secrets.
JUDGE_AGENT_TOKEN=
# Use true only on a trusted private network. Production public networks should use TLS.
JUDGE_AGENT_INSECURE=false
JUDGE_AGENT_CA_FILE=
JUDGE_AGENT_SERVER_NAME=
# Shared only by backend-http and judge nodes for authenticated artifact downloads.
JUDGE_ARTIFACT_TOKEN=

# Optional OpenAI-compatible teaching assistant
ZEORCODE_AI_ENABLED=false
ZEORCODE_AI_BASE_URL=https://api.openai.com/v1
ZEORCODE_AI_MODEL=
ZEORCODE_AI_API_KEY=
